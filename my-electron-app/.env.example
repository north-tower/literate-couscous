# Copy to .env and adjust for your environment (loaded in electron/main.js only).

# Hosted Sendline API origin (UI + agent HTTP).
# Local dev: http://127.0.0.1:5055
# Production: set to your hosted Sendline origin (no trailing slash)
SENDLINE_API_URL=http://127.0.0.1:5055

# Optional: override local job/chrome/attachment storage (default: Electron userData)
# SENDLINE_AGENT_DATA=

# Phase 2.3+: agent Bearer token — generate in hosted UI (Desktop → Link this computer); optional dev override:
# SENDLINE_AGENT_TOKEN=

# Dev worker overrides
# SENDLINE_PYTHON=py
# SENDLINE_WORKER_PY=C:\path\to\automate\worker.py
# SENDLINE_WORKER_CWD=C:\path\to\automate
# SENDLINE_DEBUG_PORT=9222

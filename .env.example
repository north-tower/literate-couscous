# Flask session cookie signing (required in production)
SECRET_KEY=

# Fernet key for LinkedIn passwords (url-safe base64, or any passphrase)
SENDLINE_SECRET_KEY=

# Created on first boot if the users table is empty
SENDLINE_ADMIN_EMAIL=admin@example.com
SENDLINE_ADMIN_PASSWORD=

# Set to 1 when HTTPS is terminating in front of Flask
SENDLINE_SECURE_COOKIES=0
